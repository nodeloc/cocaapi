cocaapi.com {
    @compressible not path /v1/chat/completions /chat/completions
    encode @compressible zstd gzip
    @chat path /v1/chat/completions /chat/completions
    header @chat {
        Cache-Control "no-cache, no-transform"
        X-Accel-Buffering no
        defer
    }
    header {
        X-Content-Type-Options nosniff
    }
    @other not path /account/* /commerce/*
    header @other Referrer-Policy strict-origin-when-cross-origin
    @account path /account/* /commerce/*
    header @account {
        Referrer-Policy no-referrer
        Cache-Control no-store
        defer
    }
    @website path / /site/* /robots.txt /sitemap.xml
    handle @website {
        root * /var/www/cocaapi/current
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
        @website_documents not path /site/*
        header @website_documents Cache-Control "public, no-cache, no-transform"
        @website_assets path /site/*
        header @website_assets Cache-Control "public, max-age=86400"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:4000 {
            flush_interval -1
        }
    }
}
