cocaapi.com {
    encode zstd gzip
    @homepage path /
    redir @homepage /account/login/ 302
    header {
        X-Content-Type-Options nosniff
    }
    @other not path /account/* /commerce/*
    header @other Referrer-Policy strict-origin-when-cross-origin
    @account path /account/* /commerce/*
    header @account {
        Referrer-Policy no-referrer
        Cache-Control no-store
        defer
    }
    reverse_proxy 127.0.0.1:4000 {
        flush_interval -1
    }
}
