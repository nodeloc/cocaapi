FROM ghcr.io/berriai/litellm:v1.106.6@sha256:37e2dafb088a7723beb998590682957386dfc83ffea1848486f8e0e5cfac0b06

USER root
COPY deploy/cocaapi/auth-requirements.txt /tmp/account-auth-requirements.txt
RUN python3 -m ensurepip --upgrade \
    && python3 -m pip install --no-cache-dir --no-deps --require-hashes -r /tmp/account-auth-requirements.txt \
    && rm /tmp/account-auth-requirements.txt

COPY litellm/models/commerce_*.py /app/.venv/lib/python3.13/site-packages/litellm/models/
COPY litellm/repositories/commerce_*_repository.py /app/.venv/lib/python3.13/site-packages/litellm/repositories/
COPY litellm/proxy/commerce/ /app/.venv/lib/python3.13/site-packages/litellm/proxy/commerce/
COPY litellm/proxy/proxy_server.py litellm/proxy/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm/proxy/
COPY litellm/proxy/auth/user_api_key_auth.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/user_api_key_auth.py
COPY litellm/litellm_core_utils/llm_cost_calc/utils.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/llm_cost_calc/utils.py
COPY litellm/litellm_core_utils/litellm_logging.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/litellm_logging.py
COPY litellm/cost_calculator.py /app/.venv/lib/python3.13/site-packages/litellm/cost_calculator.py
COPY litellm/utils.py /app/.venv/lib/python3.13/site-packages/litellm/utils.py
COPY litellm/types/utils.py /app/.venv/lib/python3.13/site-packages/litellm/types/utils.py
COPY litellm/proxy/spend_tracking/budget_reservation.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/spend_tracking/budget_reservation.py
COPY litellm/proxy/spend_tracking/spend_tracking_utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/spend_tracking/spend_tracking_utils.py
COPY litellm-proxy-extras/litellm_proxy_extras/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261101120000_commerce_auth/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261101120000_commerce_auth/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261101140000_commerce_wallet/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261101140000_commerce_wallet/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261101150000_commerce_login_settings/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261101150000_commerce_login_settings/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261102010000_commerce_api_billing/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261102010000_commerce_api_billing/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261102160000_commerce_redemption_policy/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261102160000_commerce_redemption_policy/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261102200000_commerce_billing_groups/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261102200000_commerce_billing_groups/
COPY ui/litellm-dashboard/out/ /app/cocaapi-ui/
COPY ui/litellm-dashboard/out/assets/cocaapi/cocaapi-logo-horizontal-black.png /app/.venv/lib/python3.13/site-packages/litellm/proxy/logo.png
COPY ui/litellm-dashboard/out/assets/cocaapi/cocaapi-logo-horizontal-white.png /app/.venv/lib/python3.13/site-packages/litellm/proxy/logo_dark.png
COPY ui/litellm-dashboard/out/assets/cocaapi/cocaapi-mark-black.png /app/.venv/lib/python3.13/site-packages/litellm/proxy/logo_monogram.png
COPY ui/litellm-dashboard/out/assets/cocaapi/cocaapi-mark-white.png /app/.venv/lib/python3.13/site-packages/litellm/proxy/logo_monogram_dark.png
COPY ui/litellm-dashboard/out/favicon.ico /app/.venv/lib/python3.13/site-packages/litellm/proxy/_experimental/out/favicon.ico
ENV LITELLM_UI_PATH=/app/cocaapi-ui \
    LITELLM_FAVICON_URL=/app/cocaapi-ui/assets/cocaapi/favicon-32.png
