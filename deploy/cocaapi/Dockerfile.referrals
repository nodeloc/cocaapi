ARG COCAAPI_RUNTIME_IMAGE
FROM ${COCAAPI_RUNTIME_IMAGE}

COPY litellm/models/commerce_auth.py litellm/models/commerce_wallet.py litellm/models/commerce_referrals.py /app/.venv/lib/python3.13/site-packages/litellm/models/
COPY litellm/repositories/commerce_auth_repository.py litellm/repositories/commerce_referral*_repository.py /app/.venv/lib/python3.13/site-packages/litellm/repositories/
COPY litellm/proxy/commerce/auth_service.py litellm/proxy/commerce/account_routes.py litellm/proxy/commerce/referral_routes.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/commerce/
COPY litellm/proxy/proxy_server.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/proxy_server.py
COPY schema.prisma /app/schema.prisma
COPY litellm/proxy/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm/proxy/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261103020000_commerce_referrals/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261103020000_commerce_referrals/
COPY ui/litellm-dashboard/out/ /app/cocaapi-ui/
